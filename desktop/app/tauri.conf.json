{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlvaOS",
  "mainBinaryName": "alvaos",
  "identifier": "uk.timserver.alvaos.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "dmg", "app"],
    "publisher": "AlvaOS",
    "copyright": "AlvaOS contributors",
    "category": "Utility",
    "shortDescription": "Your AlvaOS NAS from anywhere",
    "longDescription": "AlvaOS for your computer: it keeps the computer connected to your AlvaOS NAS through AlvaOS Link, from anywhere, with no router settings. The Hub apps (Files, Photos, Calendar, Contacts, Chat) in a window and in the browser, and Files as a drive.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"], "section": "net" },
      "rpm": { "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3"] }
    },
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
