#!/usr/bin/python3 -I
"""
alvaos-priv — the only program the AlvaOS backend may run as root.

    sudo -n /opt/alvaos/bin/alvaos-priv [--env KEY=VALUE]... -- /usr/bin/btrfs subvolume create ...
    sudo -n /opt/alvaos/bin/alvaos-priv write-sysfs PATH VALUE
    sudo -n /opt/alvaos/bin/alvaos-priv apply-update PACKAGE
    sudo -n /opt/alvaos/bin/alvaos-priv read-file PATH      (file on a pool, to stdout)
    sudo -n /opt/alvaos/bin/alvaos-priv files-* ...         (AlvaOS Files changes, see files_ops.py)
    sudo -n /opt/alvaos/bin/alvaos-priv --as USER files-*|read-file|file-size ...
                                                            (the same, as one person: Linux checks their rights)
    sudo -n /opt/alvaos/bin/alvaos-priv vault-open NAME HOST EXPORT MODE   (key on stdin)
    sudo -n /opt/alvaos/bin/alvaos-priv vault-close NAME
    sudo -n /opt/alvaos/bin/alvaos-priv vm-setup | vm-prepare ID | vm-grow ID | vm-delete ID | vm-isos   (virtual machines, see vm_ops.py)

Every command line is checked by priv_policy before it runs. Nothing is ever
passed to a shell. Denials exit with status 126 and are logged to
/var/log/alvaos/priv-denied.log.

This file and everything it imports must be owned by root and not writable by
the alvaos user; otherwise the backend could rewrite its own policy.
"""

import json
import os
import secrets
import shutil
import stat
import subprocess
import sys
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

import priv_policy as policy  # noqa: E402
import update_signing  # noqa: E402
import files_ops  # noqa: E402
import vault_ops  # noqa: E402
import vm_ops  # noqa: E402

DENIED_EXIT = 126
MAX_STDIN = 1024 * 1024
UPDATE_STAGING_DIR = '/var/cache/alvaos-updates'
APPLY_UPDATE_SCRIPT = '/opt/alvaos/scripts/apply_update.sh'
ALVAOS_PACKAGE_NAME = 'alvaos-system'
BASE_ENV = {
    'PATH': '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
    'LC_ALL': 'C',
    'LANG': 'C',
    'HOME': '/root',
}


def log_denied(argv, reason):
    try:
        os.makedirs('/var/log/alvaos', exist_ok=True)
        stamp = datetime.now(timezone.utc).isoformat()
        with open('/var/log/alvaos/priv-denied.log', 'a', encoding='utf-8') as f:
            f.write(f'{stamp} denied={reason!r} argv={list(argv)!r}\n')
    except Exception:
        pass


def deny(argv, reason):
    log_denied(argv, reason)
    sys.stderr.write(f'alvaos-priv: denied: {reason}\n')
    sys.exit(DENIED_EXIT)


def _secure_dir(path, mode=0o700):
    os.makedirs(path, mode=mode, exist_ok=True)
    st = os.lstat(path)
    if not os.path.isdir(path) or os.path.islink(path) or st.st_uid != 0:
        raise policy.PolicyError(f'Staging directory {path} is not a root-owned directory')
    os.chmod(path, mode)


def _open_within(path, allowed_root):
    """Open a file for reading and prove, via the open fd, where it really is.

    Checking a path and then opening it is racy (the backend could swap in a
    symlink in between). Resolving /proc/self/fd/N after opening is not.
    """
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    real = os.readlink(f'/proc/self/fd/{fd}')
    if not real.startswith(allowed_root.rstrip('/') + '/'):
        os.close(fd)
        raise policy.PolicyError(f'{path} resolves outside {allowed_root}')
    return os.fdopen(fd, 'rb')


def _stage_copy(src, allowed_root, dest_dir, name=None):
    _secure_dir(dest_dir)
    dest = os.path.join(dest_dir, name or f'{secrets.token_hex(8)}-{os.path.basename(src)}')
    with _open_within(src, allowed_root) as fin:
        fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'wb') as fout:
            shutil.copyfileobj(fin, fout, 1024 * 1024)
    return dest


def _verify_alvaos_package(staged_deb, original_path):
    """AlvaOS packages must be signed. Other Debian packages are left to dpkg."""
    name = update_signing.read_deb_package_name(staged_deb)
    if name != ALVAOS_PACKAGE_NAME:
        return
    sig_src = update_signing.signature_path_for(original_path)
    try:
        staged_sig = _stage_copy(sig_src, policy.UPDATE_CACHE_DIR, os.path.dirname(staged_deb),
                                 name=os.path.basename(staged_deb) + '.sig')
    except FileNotFoundError:
        raise policy.PolicyError('The AlvaOS package has no signature file (.sig); refusing to install it') from None
    try:
        update_signing.verify_installed_key(staged_deb, staged_sig)
    except update_signing.SignatureError as e:
        raise policy.PolicyError(f'Update signature check failed: {e}') from e


def stage_files(plan, cleanup):
    """Copy backend-writable inputs into root-owned storage and check them there."""
    stage_root = os.path.join(policy.STAGING_DIR, secrets.token_hex(8))
    cleanup.append(stage_root)
    for index, kind in sorted(plan.stage.items()):
        arg_index = index + 1  # plan.argv[0] is the binary
        original = plan.argv[arg_index]
        if kind == 'compose':
            staged = _stage_copy(original, policy.COMPOSE_DIR, stage_root)
            with open(staged, 'rb') as f:
                policy.check_compose(f.read())
            plan.argv[arg_index] = staged
            # Relative paths in the compose file keep resolving next to the original.
            plan.argv[1:1] = ['--project-directory', os.path.dirname(original)]
        elif kind == 'wg':
            # wg-quick names the interface after the file, so keep "buddy0.conf".
            staged = _stage_copy(original, policy.WG_CONFIG_PATH.rsplit('/', 2)[0], stage_root,
                                 name=os.path.basename(original))
            with open(staged, 'rb') as f:
                policy.check_wg_config(f.read())
            plan.argv[arg_index] = staged
        elif kind == 'deb':
            staged = _stage_copy(original, policy.UPDATE_CACHE_DIR, stage_root)
            _verify_alvaos_package(staged, original)
            plan.argv[arg_index] = staged
        elif kind == 'apt-sources-option':
            key, _, path = original.partition('=')
            staged = _stage_copy(path, policy.UPDATE_CACHE_DIR, stage_root)
            with open(staged, 'rb') as f:
                policy.check_apt_sources(f.read())
            os.chmod(staged, 0o644)
            plan.argv[arg_index] = f'{key}={staged}'
        else:
            raise policy.PolicyError(f'Unknown staging kind {kind}')


IOPRIO_SET = {'x86_64': 251, 'aarch64': 30, 'armv7l': 314, 'i686': 289}


def give_way():
    """Lower this process (and what it becomes) to nice 10 and the idle I/O
    class, best effort."""
    try:
        os.nice(10)
    except OSError:
        pass
    try:
        import ctypes
        number = IOPRIO_SET.get(os.uname().machine)
        if number:
            ctypes.CDLL(None, use_errno=True).syscall(number, 1, 0, 3 << 13)   # WHO_PROCESS, self, IDLE
    except (OSError, AttributeError):
        pass


def run_command(argv):
    env_pairs = []
    while argv and argv[0] == '--env':
        if len(argv) < 2:
            deny(argv, '--env needs KEY=VALUE')
        env_pairs.append(argv[1])
        argv = argv[2:]
    if not argv or argv[0] != '--':
        deny(argv, 'expected -- before the command')
    cmd = argv[1:]

    cleanup: list = []
    try:
        env = dict(BASE_ENV)
        env.update(policy.validate_env(env_pairs))
        plan = policy.validate(cmd)
        for path in plan.make_dirs:
            if os.path.islink(path):
                raise policy.PolicyError(f'{path} is a symlink')
            os.makedirs(path, mode=0o755, exist_ok=True)
        if plan.stage:
            stage_files(plan, cleanup)
        stdin_data = None
        if plan.stdin_check:
            stdin_data = sys.stdin.buffer.read(MAX_STDIN + 1)
            if len(stdin_data) > MAX_STDIN:
                raise policy.PolicyError('Input is too large')
            try:
                plan.stdin_check(stdin_data)
            except UnicodeDecodeError:
                raise policy.PolicyError('Input is not valid UTF-8') from None
    except (policy.PolicyError, OSError) as e:
        for path in cleanup:
            shutil.rmtree(path, ignore_errors=True)
        deny(cmd, str(e))

    if not os.path.isfile(plan.argv[0]):
        for path in cleanup:
            shutil.rmtree(path, ignore_errors=True)
        sys.stderr.write(f'alvaos-priv: command not installed: {plan.argv[0]}\n')
        return 127

    if plan.background:
        give_way()

    if not cleanup and stdin_data is None:
        # Nothing to feed or clean up: become the command, so output streams
        # and signals behave exactly as if it had been run directly.
        os.execve(plan.argv[0], plan.argv, env)

    try:
        result = subprocess.run(
            plan.argv,
            input=stdin_data,
            stdin=None if stdin_data is not None else subprocess.DEVNULL,
            env=env,
        )
        return result.returncode
    finally:
        for path in cleanup:
            shutil.rmtree(path, ignore_errors=True)


def write_sysfs(argv):
    if len(argv) != 2:
        deny(argv, 'usage: write-sysfs PATH VALUE')
    path, value = argv
    try:
        policy.validate_sysfs_write(path, value)
    except policy.PolicyError as e:
        deny(argv, str(e))
    with open(path, 'w', encoding='ascii') as f:
        f.write(value)
    return 0


def _installed_alvaos_version():
    try:
        res = subprocess.run(['/usr/bin/dpkg-query', '-W', '-f=${Version}', ALVAOS_PACKAGE_NAME],
                             capture_output=True, text=True, timeout=30, env=BASE_ENV)
    except (OSError, subprocess.SubprocessError):
        return ''
    return res.stdout.strip() if res.returncode == 0 else ''


def _stage_way_back(stage_dir, new_package):
    """The signed package of the version installed now, staged and verified
    like the update itself, so apply_update.sh can go back to it when the
    update fails. None when it is not in the update cache."""
    for path in update_signing.packages_of_version(policy.UPDATE_CACHE_DIR, _installed_alvaos_version(),
                                                   exclude=new_package):
        try:
            staged = _stage_copy(path, policy.UPDATE_CACHE_DIR, stage_dir, name='way-back.deb')
            if update_signing.read_deb_package_name(staged) != ALVAOS_PACKAGE_NAME:
                raise policy.PolicyError('not an AlvaOS package')
            _verify_alvaos_package(staged, path)
            return staged
        except (policy.PolicyError, OSError):
            for leftover in ('way-back.deb', 'way-back.deb.sig'):
                try:
                    os.unlink(os.path.join(stage_dir, leftover))
                except OSError:
                    pass
    return None


def apply_update(argv):
    """Verify a signed AlvaOS package and hand it to apply_update.sh, detached."""
    if len(argv) != 1:
        deny(argv, 'usage: apply-update PACKAGE')
    try:
        package = policy.validate_update_package(argv[0])
        _secure_dir(UPDATE_STAGING_DIR)
        # Old staged packages are no longer needed once a new update starts.
        for entry in os.listdir(UPDATE_STAGING_DIR):
            shutil.rmtree(os.path.join(UPDATE_STAGING_DIR, entry), ignore_errors=True)
        stage_dir = os.path.join(UPDATE_STAGING_DIR, secrets.token_hex(8))
        staged = _stage_copy(package, policy.UPDATE_CACHE_DIR, stage_dir,
                             name=os.path.basename(package))
        if update_signing.read_deb_package_name(staged) != ALVAOS_PACKAGE_NAME:
            raise policy.PolicyError('This is not an AlvaOS package')
        _verify_alvaos_package(staged, package)
    except (policy.PolicyError, OSError) as e:
        deny(argv, str(e))

    unit = 'alvaos-updater-' + secrets.token_hex(4)
    cmd = [
        '/usr/bin/systemd-run', f'--unit={unit}', '--description=AlvaOS Updater',
        '--no-block', '/usr/bin/bash', APPLY_UPDATE_SCRIPT, staged,
    ]
    way_back = _stage_way_back(stage_dir, package)
    if way_back:
        cmd.append(way_back)
    return subprocess.run(cmd, env=BASE_ENV, stdin=subprocess.DEVNULL).returncode


def open_data_file(path, root=None):
    """Open a regular file on a pool for reading. The check is made on the
    open file, not the name, so swapping in a symlink meanwhile does not help."""
    root = root or policy.POOL_MOUNT_BASE
    if not isinstance(path, str) or not path.startswith('/') or '\x00' in path:
        raise policy.PolicyError('Invalid path')
    f = _open_within(path, root)
    if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
        f.close()
        raise policy.PolicyError('Only files can be read')
    return f


def read_file(argv):
    """AlvaOS Files: stream one file from a pool to stdout, whole or one part
    (START LENGTH, for seeking in videos and resuming downloads)."""
    if len(argv) not in (1, 3):
        deny(argv, 'usage: read-file PATH [START LENGTH]')
    try:
        f = open_data_file(argv[0])
        start = int(policy._int_arg(argv[1], 0, 10**15)) if len(argv) == 3 else 0
        length = int(policy._int_arg(argv[2], 1, 10**15)) if len(argv) == 3 else None
    except (policy.PolicyError, OSError) as e:
        deny(['read-file'] + list(argv), str(e))
    with f:
        try:
            f.seek(start)
            left = length
            while left is None or left > 0:
                chunk = f.read(1024 * 1024 if left is None else min(1024 * 1024, left))
                if not chunk:
                    break
                sys.stdout.buffer.write(chunk)
                if left is not None:
                    left -= len(chunk)
            sys.stdout.buffer.flush()
        except BrokenPipeError:
            pass   # the browser stopped the download
    return 0


def file_size(argv):
    """AlvaOS Files: the size of one file on a pool, as JSON."""
    if len(argv) != 1:
        deny(argv, 'usage: file-size PATH')
    try:
        with open_data_file(argv[0]) as f:
            size = os.fstat(f.fileno()).st_size
    except (policy.PolicyError, OSError) as e:
        deny(['file-size'] + list(argv), str(e))
    sys.stdout.write(json.dumps({'size': size}) + '\n')
    return 0


# AlvaOS Files: name -> (number of arguments, function); None means a name
# and 1 to 101 folders (the current one and up to 100 restore points). files_ops checks
# every folder on its open descriptor and never overwrites anything but Hub app data.
FILES_OPS = {
    'files-list': (1, lambda a: {'entries': files_ops.list_dir(a[0])}),
    'files-search': (2, lambda a: files_ops.search(a[0], a[1])),
    'files-media': (1, lambda a: files_ops.media(a[0])),
    'files-versions': (None, lambda a: {'versions': files_ops.versions(a[0], a[1:])}),
    'files-restore-version': (4, lambda a: {'name': files_ops.restore_version(a[0], a[1], a[2], a[3])}),
    'files-write': (2, lambda a: {'written': files_ops.write_file(a[0], a[1], sys.stdin.buffer)}),
    'files-mkdir': (2, lambda a: files_ops.make_dir(a[0], a[1])),
    'files-rename': (3, lambda a: files_ops.rename(a[0], a[1], a[2])),
    'files-move': (3, lambda a: files_ops.move(a[0], a[1], a[2])),
    'files-copy': (3, lambda a: {'name': files_ops.copy(a[0], a[1], a[2])}),
    'files-part-size': (2, lambda a: {'size': files_ops.part_size(a[0], a[1])}),
    'files-part-write': (3, lambda a: {'size': files_ops.part_write(
        a[0], a[1], int(policy._int_arg(a[2], 0, 10**15)), sys.stdin.buffer)}),
    'files-part-finish': (3, lambda a: files_ops.part_finish(a[0], a[1], int(policy._int_arg(a[2], 0, 10**15)))),
    'files-part-abort': (2, lambda a: files_ops.part_abort(a[0], a[1])),
    'files-part-finish-dated': (4, lambda a: files_ops.part_finish(
        a[0], a[1], int(policy._int_arg(a[2], 0, 10**15)), mtime=int(policy._int_arg(a[3], 0, 10**11)))),
    'files-trash': (3, lambda a: {'id': files_ops.trash(a[0], a[1], a[2])}),
    'files-trash-list': (1, lambda a: {'items': files_ops.list_trash(a[0])}),
    'files-trash-restore': (2, lambda a: files_ops.restore(a[0], a[1])),
    'files-trash-purge': (2, lambda a: {'removed': files_ops.purge(a[0], int(policy._int_arg(a[1], 0, 3650)))}),
    # Hub apps (Calendar, Chat): their JSON files below ".alvaos/" of a share.
    'files-data-read': (2, lambda a: files_ops.read_app_data(a[0], a[1])),
    'files-data-write': (2, lambda a: {'written': files_ops.write_app_data(a[0], a[1], sys.stdin.buffer)}),
    'files-data-delete': (2, lambda a: files_ops.delete_app_data(a[0], a[1])),
}


# Operations that may run as one person (`--as USER`), so Linux checks their
# rights exactly as for their network shares.
AS_USER_OPS = set(FILES_OPS) - {'files-trash-purge'} | {'read-file', 'file-size', 'files-zip'}


def become(user):
    """Drop root for good and continue as a regular account (uid 1000+, not
    root, alvaos or nobody), with its groups and a umask that keeps new files
    usable for the share's group."""
    import pwd
    policy._user(policy.System(), user, must_exist=True, deletable=True)
    pw = pwd.getpwnam(user)
    os.setgroups(os.getgrouplist(user, pw.pw_gid))
    os.setgid(pw.pw_gid)
    os.setuid(pw.pw_uid)
    if os.getuid() == 0 or os.geteuid() == 0:
        raise policy.PolicyError('Could not drop root')
    os.umask(0o007)


def files_zip(argv):
    """AlvaOS Files: a folder as a ZIP stream on stdout."""
    if len(argv) != 1:
        deny(['files-zip'] + list(argv), 'usage: files-zip DIR')
    try:
        files_ops.zip_folder(argv[0], sys.stdout.buffer)
        sys.stdout.buffer.flush()
    except files_ops.FileOpError as e:
        sys.stderr.write(f'{e}\n')
        return 1
    except BrokenPipeError:
        pass   # the browser stopped the download
    return 0


def files_op(name, argv):
    count, run = FILES_OPS[name]
    if (count is None and not 2 <= len(argv) <= 102) or (count is not None and len(argv) != count):
        deny([name] + list(argv), f'usage: {name} with {count} arguments')
    try:
        result = run(argv)
    except files_ops.FileOpError as e:
        sys.stderr.write(f'{e}\n')
        return 1
    except policy.PolicyError as e:
        deny([name] + list(argv), str(e))
    except OSError as e:
        sys.stderr.write(f'{e.strerror or e}\n')
        return 1
    sys.stdout.write(json.dumps(result if isinstance(result, dict) else {}) + '\n')
    return 0


def main():
    if os.geteuid() != 0:
        sys.stderr.write('alvaos-priv: must be run as root (via sudo)\n')
        return 1
    os.umask(0o022)
    args = sys.argv[1:]
    if args[:1] == ['--as']:
        if len(args) < 3 or args[2] not in AS_USER_OPS:
            deny(args, 'usage: --as USER files-...|read-file|file-size ...')
        try:
            become(args[1])
        except (policy.PolicyError, KeyError, OSError) as e:
            deny(args, f'cannot act as {args[1]}: {e}')
        args = args[2:]
    if args[:1] == ['write-sysfs']:
        return write_sysfs(args[1:])
    if args[:1] == ['apply-update']:
        return apply_update(args[1:])
    if args[:1] == ['read-file']:
        return read_file(args[1:])
    if args[:1] == ['file-size']:
        return file_size(args[1:])
    if args[:1] == ['files-zip']:
        return files_zip(args[1:])
    if args and args[0] in FILES_OPS:
        return files_op(args[0], args[1:])
    if args and args[0] in vm_ops.HELPER_OPS:
        return vm_ops.helper_main(args)
    if args[:1] in (['vault-open'], ['vault-close']):
        # Buddy Backup vaults: attach, unlock and mount, or the reverse.
        stdin = sys.stdin.buffer.read(1024) if args[0] == 'vault-open' else b''
        return vault_ops.main(args, stdin)
    return run_command(args)


if __name__ == '__main__':
    sys.exit(main())
