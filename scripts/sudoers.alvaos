# AlvaOS Permissions - Canonical Source
# Keep this file as the single source of truth for /etc/sudoers.d/alvaos
#
# The backend may run exactly one program as root: the privilege helper.
# The helper validates every command against backend/priv_policy.py and never
# runs a shell. Do not add rules here; extend the policy instead.
Defaults:alvaos !requiretty
alvaos ALL=(root) NOPASSWD: /opt/alvaos/bin/alvaos-priv
