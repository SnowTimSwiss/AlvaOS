[Unit]
Description=AlvaOS Link (phones and buddies reach this NAS without a router setting)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own account would be tidier, but it must give the services of the NAS
# (Hub, backup code) a password file to read: group alvaos reads it.
User=alvaos
Group=alvaos
WorkingDirectory=/opt/alvaos/bin
ExecStart=/usr/bin/python3 /opt/alvaos/bin/link_daemon.py
Restart=always
RestartSec=5
Environment="PYTHONUNBUFFERED=1"
NoNewPrivileges=yes
ProtectSystem=strict
# systemd makes the folder (owned by the service account) before it sets up the sandbox,
# and lets the service write there. ReadWritePaths= alone would fail while it is missing.
StateDirectory=alvaos/link
StateDirectoryMode=0750
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
