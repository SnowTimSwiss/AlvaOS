{
  "nextcloud": {
    "name": "Nextcloud",
    "description": "Self-hosted cloud storage and collaboration platform",
    "icon": "/apps/icons/nextcloud.png",
    "category": "Productivity",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "nextcloud": {
          "image": "nextcloud:latest",
          "restart": "unless-stopped",
          "ports": [
            "8081:80"
          ],
          "volumes": [
            "${POOL_PATH}/data:/var/www/html"
          ],
          "environment": {
            "MYSQL_HOST": "db",
            "MYSQL_DATABASE": "nextcloud",
            "MYSQL_USER": "nextcloud",
            "MYSQL_PASSWORD": "CHANGEME"
          }
        },
        "db": {
          "image": "mariadb:10",
          "restart": "unless-stopped",
          "volumes": [
            "${POOL_PATH}/database:/var/lib/mysql"
          ],
          "environment": {
            "MYSQL_ROOT_PASSWORD": "CHANGEME",
            "MYSQL_DATABASE": "nextcloud",
            "MYSQL_USER": "nextcloud",
            "MYSQL_PASSWORD": "CHANGEME"
          }
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 80,
          "external": 8081,
          "protocol": "tcp",
          "description": "Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/var/www/html",
          "description": "Nextcloud data and config",
          "required": true
        },
        {
          "container_path": "/var/lib/mysql",
          "description": "Database storage",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "NEXTCLOUD_TRUSTED_DOMAINS",
          "default": "localhost 127.0.0.1",
          "description": "Space-separated trusted hostnames or host:port entries"
        },
        {
          "key": "MYSQL_PASSWORD",
          "default": "",
          "description": "Database password — change before first use",
          "required": true,
          "secret": true,
          "generate": true
        },
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "description": "Database root password",
          "default": "",
          "required": true,
          "secret": true,
          "generate": true
        }
      ]
    }
  },
  "jellyfin": {
    "name": "Jellyfin",
    "description": "Free media server for your movies, music, and TV shows",
    "icon": "/apps/icons/jellyfin.png",
    "category": "Media",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "jellyfin": {
          "image": "jellyfin/jellyfin:latest",
          "restart": "unless-stopped",
          "ports": [
            "8096:8096"
          ],
          "volumes": [
            "${POOL_PATH}/config:/config",
            "${POOL_PATH}/cache:/cache",
            "${POOL_PATH}/media:/media"
          ],
          "environment": {
            "TZ": "UTC"
          }
        }
      }
    },
    "gpu": {
      "service": "jellyfin",
      "vendors": [
        "intel",
        "amd",
        "nvidia"
      ],
      "after": "Then in Jellyfin: Dashboard › Playback › Transcoding, choose the hardware acceleration (Intel: Intel QuickSync, AMD: VA-API, NVIDIA: NVENC)."
    },
    "config_schema": {
      "ports": [
        {
          "internal": 8096,
          "external": 8096,
          "protocol": "tcp",
          "description": "Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/config",
          "description": "Configuration files",
          "required": true
        },
        {
          "container_path": "/cache",
          "description": "Cache directory",
          "required": true
        },
        {
          "container_path": "/media",
          "description": "Media files location",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "TZ",
          "default": "UTC",
          "description": "Timezone (e.g. Europe/Berlin, America/New_York)"
        }
      ]
    }
  },
  "pihole": {
    "name": "Pi-hole",
    "description": "Network-wide ad blocker and DNS server",
    "icon": "/apps/icons/pihole.png",
    "category": "Network",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "pihole": {
          "image": "pihole/pihole:latest",
          "restart": "unless-stopped",
          "ports": [
            "53:53/tcp",
            "53:53/udp",
            "8053:80/tcp"
          ],
          "volumes": [
            "${POOL_PATH}/etc-pihole:/etc/pihole",
            "${POOL_PATH}/etc-dnsmasq.d:/etc/dnsmasq.d"
          ],
          "environment": {
            "TZ": "UTC",
            "WEBPASSWORD": "CHANGEME"
          }
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 80,
          "external": 8053,
          "protocol": "tcp",
          "description": "Web UI"
        },
        {
          "internal": 53,
          "external": 53,
          "protocol": "tcp",
          "description": "DNS (TCP)"
        },
        {
          "internal": 53,
          "external": 53,
          "protocol": "udp",
          "description": "DNS (UDP)"
        }
      ],
      "webui_path": "/admin/login",
      "volumes": [
        {
          "container_path": "/etc/pihole",
          "description": "Pi-hole configuration",
          "required": true
        },
        {
          "container_path": "/etc/dnsmasq.d",
          "description": "DNS configuration",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "WEBPASSWORD",
          "default": "",
          "description": "Admin password for the Pi-hole web interface",
          "required": true,
          "secret": true
        },
        {
          "key": "TZ",
          "default": "UTC",
          "description": "Timezone (e.g. Europe/Berlin, America/New_York)"
        }
      ]
    }
  },
  "vaultwarden": {
    "name": "Vaultwarden",
    "description": "Self-hosted password manager (Bitwarden compatible)",
    "icon": "/apps/icons/vaultwarden.png",
    "category": "Security",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "vaultwarden": {
          "image": "vaultwarden/server:latest",
          "restart": "unless-stopped",
          "ports": [
            "8090:80"
          ],
          "volumes": [
            "${POOL_PATH}/data:/data"
          ],
          "environment": {
            "WEBSOCKET_ENABLED": "true"
          }
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 80,
          "external": 8090,
          "protocol": "tcp",
          "description": "Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/data",
          "description": "Vault data",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "WEBSOCKET_ENABLED",
          "default": "true",
          "description": "Enable WebSocket notifications"
        }
      ]
    }
  },
  "immich": {
    "name": "Immich",
    "description": "High-performance self-hosted photo and video backup solution",
    "icon": "/apps/icons/immich.png",
    "category": "Media",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "immich-server": {
          "image": "ghcr.io/immich-app/immich-server:release",
          "restart": "unless-stopped",
          "ports": [
            "2283:3001"
          ],
          "volumes": [
            "${POOL_PATH}/upload:/usr/src/app/upload"
          ],
          "environment": {
            "DB_HOSTNAME": "immich-postgres",
            "DB_USERNAME": "postgres",
            "DB_PASSWORD": "CHANGEME",
            "DB_DATABASE_NAME": "immich",
            "REDIS_HOSTNAME": "immich-redis",
            "TZ": "UTC"
          },
          "depends_on": [
            "immich-redis",
            "immich-postgres"
          ]
        },
        "immich-redis": {
          "image": "redis:7-alpine",
          "restart": "unless-stopped"
        },
        "immich-postgres": {
          "image": "tensorchord/pgvecto-rs:pg14-v0.2.0",
          "restart": "unless-stopped",
          "volumes": [
            "${POOL_PATH}/postgres:/var/lib/postgresql/data"
          ],
          "environment": {
            "POSTGRES_PASSWORD": "CHANGEME",
            "POSTGRES_USER": "postgres",
            "POSTGRES_DB": "immich"
          }
        }
      }
    },
    "gpu": {
      "service": "immich-server",
      "vendors": [
        "intel",
        "amd",
        "nvidia"
      ],
      "after": "Then in Immich: Administration › Settings › Video Transcoding › Hardware Acceleration."
    },
    "config_schema": {
      "ports": [
        {
          "internal": 3001,
          "external": 2283,
          "protocol": "tcp",
          "description": "Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/usr/src/app/upload",
          "description": "Uploaded photos and videos",
          "required": true
        },
        {
          "container_path": "/var/lib/postgresql/data",
          "description": "Database storage",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "DB_PASSWORD",
          "default": "",
          "description": "Database password — change before first use",
          "required": true,
          "secret": true,
          "generate": true
        },
        {
          "key": "TZ",
          "default": "UTC",
          "description": "Timezone (e.g. Europe/Berlin, America/New_York)"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "description": "Database password",
          "default": "",
          "required": true,
          "secret": true,
          "generate": true
        }
      ]
    }
  },
  "transmission": {
    "name": "Transmission",
    "description": "Fast, easy, and free BitTorrent client",
    "icon": "/apps/icons/transmission.png",
    "category": "Media",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "transmission": {
          "image": "linuxserver/transmission:latest",
          "restart": "unless-stopped",
          "environment": {
            "USER": "admin",
            "PASS": "CHANGEME",
            "TZ": "UTC"
          },
          "ports": [
            "9091:9091",
            "51413:51413",
            "51413:51413/udp"
          ],
          "volumes": [
            "${POOL_PATH}/config:/config",
            "${POOL_PATH}/downloads:/downloads",
            "${POOL_PATH}/watch:/watch"
          ]
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 9091,
          "external": 9091,
          "protocol": "tcp",
          "description": "Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/config",
          "description": "Configuration files",
          "required": true
        },
        {
          "container_path": "/downloads",
          "description": "Downloads directory",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "PASS",
          "default": "",
          "description": "Password for the Transmission web interface",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "cloudflared": {
    "name": "Cloudflared",
    "description": "Cloudflare Tunnel connector for secure inbound access",
    "icon": "/apps/icons/cloudflared.png",
    "category": "Network",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "cloudflared": {
          "image": "cloudflare/cloudflared:latest",
          "restart": "unless-stopped",
          "command": "tunnel --no-autoupdate run",
          "environment": {
            "TUNNEL_TOKEN": ""
          },
          "volumes": [
            "${POOL_PATH}/config:/etc/cloudflared"
          ]
        }
      }
    },
    "config_schema": {
      "ports": [],
      "volumes": [
        {
          "container_path": "/etc/cloudflared",
          "description": "Tunnel configuration and credentials",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "TUNNEL_TOKEN",
          "default": "",
          "description": "Cloudflare tunnel token from Zero Trust dashboard"
        }
      ]
    }
  },
  "uptimekuma": {
    "name": "Uptime Kuma",
    "description": "Self-hosted monitoring with status pages and alerting",
    "icon": "/apps/icons/uptimekuma.png",
    "category": "Monitoring",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "uptime-kuma": {
          "image": "louislam/uptime-kuma:2",
          "restart": "unless-stopped",
          "ports": [
            "3001:3001"
          ],
          "environment": {
            "TZ": "UTC"
          },
          "volumes": [
            "${POOL_PATH}/data:/app/data"
          ]
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 3001,
          "external": 3001,
          "protocol": "tcp",
          "description": "Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/app/data",
          "description": "Monitor data and settings",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "TZ",
          "default": "UTC",
          "description": "Timezone (e.g. Europe/Berlin, America/New_York)"
        }
      ]
    }
  },
  "ollama": {
    "name": "Ollama",
    "description": "Run local LLM inference with open models",
    "icon": "/apps/icons/ollama.png",
    "category": "AI",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "ollama": {
          "image": "ollama/ollama:latest",
          "restart": "unless-stopped",
          "ports": [
            "11434:11434"
          ],
          "environment": {
            "OLLAMA_ORIGINS": "*",
            "OLLAMA_KEEP_ALIVE": "5m"
          },
          "volumes": [
            "${POOL_PATH}/models:/root/.ollama"
          ]
        }
      }
    },
    "gpu": {
      "service": "ollama",
      "vendors": [
        "nvidia",
        "amd"
      ],
      "images": {
        "amd": "ollama/ollama:rocm"
      },
      "kfd": true,
      "after": "Ollama uses the card by itself; models that fit in the card's memory run much faster."
    },
    "config_schema": {
      "ports": [
        {
          "internal": 11434,
          "external": 11434,
          "protocol": "tcp",
          "description": "API"
        }
      ],
      "volumes": [
        {
          "container_path": "/root/.ollama",
          "description": "Downloaded models and runtime data",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "OLLAMA_ORIGINS",
          "default": "*",
          "description": "Allowed CORS origins for browser-based clients"
        },
        {
          "key": "OLLAMA_KEEP_ALIVE",
          "default": "5m",
          "description": "How long models stay loaded in memory"
        }
      ]
    }
  },
  "eurooffice": {
    "name": "Euro-Office Document Server",
    "description": "Sovereign European fork of ONLYOFFICE Document Server — collaborative online editing for documents, spreadsheets and presentations (e.g. as a Nextcloud editor backend)",
    "icon": "/apps/icons/eurooffice.png",
    "category": "Productivity",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "eurooffice": {
          "image": "ghcr.io/euro-office/documentserver:latest",
          "restart": "unless-stopped",
          "ports": [
            "8082:80"
          ],
          "volumes": [
            "${POOL_PATH}/data:/var/www/onlyoffice/Data",
            "${POOL_PATH}/log:/var/log/onlyoffice",
            "${POOL_PATH}/db:/var/lib/onlyoffice"
          ],
          "environment": {
            "JWT_SECRET": "CHANGEME",
            "EXAMPLE_ENABLED": "false"
          }
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 80,
          "external": 8082,
          "protocol": "tcp",
          "description": "Document Server / Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/var/www/onlyoffice/Data",
          "description": "Document Server certificates and data",
          "required": true
        },
        {
          "container_path": "/var/log/onlyoffice",
          "description": "Log files",
          "required": false
        },
        {
          "container_path": "/var/lib/onlyoffice",
          "description": "Internal database and cache",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "JWT_SECRET",
          "default": "",
          "description": "Secret used to sign login tokens",
          "required": true,
          "secret": true,
          "generate": true
        },
        {
          "key": "EXAMPLE_ENABLED",
          "default": "false",
          "description": "Enable the built-in example/test page"
        }
      ]
    }
  },
  "wireguard": {
    "name": "WireGuard Easy",
    "description": "Self-hosted WireGuard VPN with a simple web-based admin UI for managing clients",
    "icon": "/apps/icons/wireguard.png",
    "category": "Network",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "wireguard": {
          "image": "ghcr.io/wg-easy/wg-easy:15",
          "restart": "unless-stopped",
          "ports": [
            "51820:51820/udp",
            "51821:51821/tcp"
          ],
          "volumes": [
            "${POOL_PATH}/data:/etc/wireguard"
          ],
          "environment": {
            "WG_HOST": "CHANGEME"
          },
          "cap_add": [
            "NET_ADMIN"
          ],
          "sysctls": {
            "net.ipv4.ip_forward": "1",
            "net.ipv4.conf.all.src_valid_mark": "1"
          }
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 51821,
          "external": 51821,
          "protocol": "tcp",
          "description": "Web UI"
        },
        {
          "internal": 51820,
          "external": 51820,
          "protocol": "udp",
          "description": "WireGuard VPN traffic"
        }
      ],
      "volumes": [
        {
          "container_path": "/etc/wireguard",
          "description": "VPN configuration, keys and client data",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "WG_HOST",
          "default": "",
          "description": "Public hostname or IP clients use to reach this VPN",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "openwebui": {
    "name": "Open WebUI",
    "description": "Web interface for Ollama and other LLM backends",
    "icon": "/apps/icons/openwebui.png",
    "category": "AI",
    "version": "latest",
    "docker_compose": {
      "version": "3",
      "services": {
        "open-webui": {
          "image": "ghcr.io/open-webui/open-webui:main",
          "restart": "unless-stopped",
          "ports": [
            "3000:8080"
          ],
          "extra_hosts": [
            "host.docker.internal:host-gateway"
          ],
          "environment": {
            "OLLAMA_BASE_URL": "http://host.docker.internal:11434",
            "WEBUI_URL": "http://localhost:3000",
            "WEBUI_SECRET_KEY": "CHANGEME"
          },
          "volumes": [
            "${POOL_PATH}/data:/app/backend/data"
          ]
        }
      }
    },
    "config_schema": {
      "ports": [
        {
          "internal": 8080,
          "external": 3000,
          "protocol": "tcp",
          "description": "Web UI"
        }
      ],
      "volumes": [
        {
          "container_path": "/app/backend/data",
          "description": "Open WebUI database and files",
          "required": true
        }
      ],
      "environment": [
        {
          "key": "OLLAMA_BASE_URL",
          "default": "http://host.docker.internal:11434",
          "description": "URL to Ollama API endpoint"
        },
        {
          "key": "WEBUI_URL",
          "default": "http://localhost:3000",
          "description": "Public URL used by Open WebUI"
        },
        {
          "key": "WEBUI_SECRET_KEY",
          "default": "",
          "description": "Secret used to sign sessions",
          "required": true,
          "secret": true,
          "generate": true
        }
      ]
    }
  }
}
