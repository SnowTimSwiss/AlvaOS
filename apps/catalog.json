{
    "nextcloud": {
        "name": "Nextcloud",
        "description": "Self-hosted cloud storage and collaboration platform",
        "icon": "/apps/icons/nextcloud.png",
        "category": "Productivity",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "nextcloud": {
                    "image": "nextcloud:latest",
                    "restart": "unless-stopped",
                    "ports": [
                        "8081:80"
                    ],
                    "volumes": [
                        "${POOL_PATH}/data:/var/www/html"
                    ],
                    "environment": {
                        "MYSQL_HOST": "db",
                        "MYSQL_DATABASE": "nextcloud",
                        "MYSQL_USER": "nextcloud",
                        "MYSQL_PASSWORD": "nextcloud"
                    }
                },
                "db": {
                    "image": "mariadb:10",
                    "restart": "unless-stopped",
                    "volumes": [
                        "${POOL_PATH}/database:/var/lib/mysql"
                    ],
                    "environment": {
                        "MYSQL_ROOT_PASSWORD": "nextcloud",
                        "MYSQL_DATABASE": "nextcloud",
                        "MYSQL_USER": "nextcloud",
                        "MYSQL_PASSWORD": "nextcloud"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 80,
                    "external": 8081,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/var/www/html",
                    "description": "Nextcloud data and config",
                    "required": true
                },
                {
                    "container_path": "/var/lib/mysql",
                    "description": "Database storage",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "MYSQL_PASSWORD",
                    "default": "nextcloud",
                    "description": "Database password"
                }
            ]
        }
    },
    "jellyfin": {
        "name": "Jellyfin",
        "description": "Free media server for your movies, music, and TV shows",
        "icon": "/apps/icons/jellyfin.png",
        "category": "Media",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "jellyfin": {
                    "image": "jellyfin/jellyfin:latest",
                    "restart": "unless-stopped",
                    "ports": [
                        "8096:8096"
                    ],
                    "volumes": [
                        "${POOL_PATH}/config:/config",
                        "${POOL_PATH}/cache:/cache",
                        "${POOL_PATH}/media:/media"
                    ],
                    "environment": {
                        "TZ": "Europe/Berlin"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 8096,
                    "external": 8096,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration files",
                    "required": true
                },
                {
                    "container_path": "/cache",
                    "description": "Cache directory",
                    "required": true
                },
                {
                    "container_path": "/media",
                    "description": "Media files location",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "TZ",
                    "default": "Europe/Berlin",
                    "description": "Timezone"
                }
            ]
        }
    },
    "homeassistant": {
        "name": "Home Assistant",
        "description": "Open source home automation platform",
        "icon": "/apps/icons/homeassistant.png",
        "category": "Smart Home",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "homeassistant": {
                    "image": "ghcr.io/home-assistant/home-assistant:stable",
                    "restart": "unless-stopped",
                    "network_mode": "host",
                    "volumes": [
                        "${POOL_PATH}/config:/config"
                    ],
                    "environment": {
                        "TZ": "Europe/Berlin"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 8123,
                    "external": 8123,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration directory",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "TZ",
                    "default": "Europe/Berlin",
                    "description": "Timezone"
                }
            ]
        }
    },
    "pihole": {
        "name": "Pi-hole",
        "description": "Network-wide ad blocker and DNS server",
        "icon": "/apps/icons/pihole.png",
        "category": "Network",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "pihole": {
                    "image": "pihole/pihole:latest",
                    "restart": "unless-stopped",
                    "ports": [
                        "53:53/tcp",
                        "53:53/udp",
                        "8053:80/tcp"
                    ],
                    "volumes": [
                        "${POOL_PATH}/etc-pihole:/etc/pihole",
                        "${POOL_PATH}/etc-dnsmasq.d:/etc/dnsmasq.d"
                    ],
                    "environment": {
                        "TZ": "Europe/Berlin",
                        "WEBPASSWORD": "admin"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 80,
                    "external": 8053,
                    "protocol": "tcp",
                    "description": "Web UI"
                },
                {
                    "internal": 53,
                    "external": 53,
                    "protocol": "tcp",
                    "description": "DNS (TCP)"
                },
                {
                    "internal": 53,
                    "external": 53,
                    "protocol": "udp",
                    "description": "DNS (UDP)"
                }
            ],
            "webui_path": "/admin/login",
            "volumes": [
                {
                    "container_path": "/etc/pihole",
                    "description": "Pi-hole configuration",
                    "required": true
                },
                {
                    "container_path": "/etc/dnsmasq.d",
                    "description": "DNS configuration",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "WEBPASSWORD",
                    "default": "admin",
                    "description": "Web UI password"
                },
                {
                    "key": "TZ",
                    "default": "Europe/Berlin",
                    "description": "Timezone"
                }
            ]
        }
    },
    "vaultwarden": {
        "name": "Vaultwarden",
        "description": "Self-hosted password manager (Bitwarden compatible)",
        "icon": "/apps/icons/vaultwarden.png",
        "category": "Security",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "vaultwarden": {
                    "image": "vaultwarden/server:latest",
                    "restart": "unless-stopped",
                    "ports": [
                        "8090:80"
                    ],
                    "volumes": [
                        "${POOL_PATH}/data:/data"
                    ],
                    "environment": {
                        "WEBSOCKET_ENABLED": "true"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 80,
                    "external": 8090,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/data",
                    "description": "Vault data",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "WEBSOCKET_ENABLED",
                    "default": "true",
                    "description": "Enable WebSocket notifications"
                }
            ]
        }
    },
    "immich": {
        "name": "Immich",
        "description": "High-performance self-hosted photo and video backup solution",
        "icon": "/apps/icons/immich.png",
        "category": "Media",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "immich-server": {
                    "image": "ghcr.io/immich-app/immich-server:release",
                    "restart": "unless-stopped",
                    "ports": [
                        "2283:3001"
                    ],
                    "volumes": [
                        "${POOL_PATH}/upload:/usr/src/app/upload"
                    ],
                    "environment": {
                        "DB_HOSTNAME": "immich-postgres",
                        "DB_USERNAME": "postgres",
                        "DB_PASSWORD": "postgres",
                        "DB_DATABASE_NAME": "immich",
                        "REDIS_HOSTNAME": "immich-redis",
                        "TZ": "Europe/Berlin"
                    },
                    "depends_on": [
                        "immich-redis",
                        "immich-postgres"
                    ]
                },
                "immich-redis": {
                    "image": "redis:7-alpine",
                    "restart": "unless-stopped"
                },
                "immich-postgres": {
                    "image": "tensorchord/pgvecto-rs:pg14-v0.2.0",
                    "restart": "unless-stopped",
                    "volumes": [
                        "${POOL_PATH}/postgres:/var/lib/postgresql/data"
                    ],
                    "environment": {
                        "POSTGRES_PASSWORD": "postgres",
                        "POSTGRES_USER": "postgres",
                        "POSTGRES_DB": "immich"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 3001,
                    "external": 2283,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/usr/src/app/upload",
                    "description": "Uploaded photos and videos",
                    "required": true
                },
                {
                    "container_path": "/var/lib/postgresql/data",
                    "description": "Database storage",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "DB_PASSWORD",
                    "default": "postgres",
                    "description": "Database password"
                },
                {
                    "key": "TZ",
                    "default": "Europe/Berlin",
                    "description": "Timezone"
                }
            ]
        }
    },
    "owncloud": {
        "name": "ownCloud",
        "description": "Classic self-hosted file sync and share server",
        "icon": "/apps/icons/owncloud.png",
        "category": "Productivity",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "owncloud": {
                    "image": "owncloud/server:latest",
                    "restart": "unless-stopped",
                    "ports": [
                        "8082:8080"
                    ],
                    "volumes": [
                        "${POOL_PATH}/data:/var/www/html"
                    ],
                    "environment": {
                        "OWNCLOUD_DOMAIN": "localhost:8082",
                        "OWNCLOUD_DB_TYPE": "sqlite",
                        "OWNCLOUD_ADMIN_USERNAME": "admin",
                        "OWNCLOUD_ADMIN_PASSWORD": "admin"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 8080,
                    "external": 8082,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/var/www/html",
                    "description": "ownCloud data and config",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "OWNCLOUD_ADMIN_PASSWORD",
                    "default": "admin",
                    "description": "Admin password"
                }
            ]
        }
    },
    "opencloud": {
        "name": "OpenCloud",
        "description": "Next-generation cloud-native file platform",
        "icon": "/apps/icons/opencloud.png",
        "category": "Productivity",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "opencloud": {
                    "image": "opencloudeu/opencloud-rolling:latest",
                    "restart": "unless-stopped",
                    "ports": [
                        "8085:8080"
                    ],
                    "volumes": [
                        "${POOL_PATH}/data:/var/lib/opencloud"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 8080,
                    "external": 8085,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/var/lib/opencloud",
                    "description": "OpenCloud data",
                    "required": true
                }
            ]
        }
    },
    "transmission": {
        "name": "Transmission",
        "description": "Fast, easy, and free BitTorrent client",
        "icon": "/apps/icons/transmission.png",
        "category": "Media",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "transmission": {
                    "image": "linuxserver/transmission:latest",
                    "restart": "unless-stopped",
                    "environment": {
                        "USER": "admin",
                        "PASS": "admin",
                        "TZ": "Europe/Berlin"
                    },
                    "ports": [
                        "9091:9091",
                        "51413:51413",
                        "51413:51413/udp"
                    ],
                    "volumes": [
                        "${POOL_PATH}/config:/config",
                        "${POOL_PATH}/downloads:/downloads",
                        "${POOL_PATH}/watch:/watch"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 9091,
                    "external": 9091,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration files",
                    "required": true
                },
                {
                    "container_path": "/downloads",
                    "description": "Downloads directory",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "PASS",
                    "default": "admin",
                    "description": "Web UI password"
                }
            ]
        }
    },
    "wireguard": {
        "name": "WireGuard",
        "description": "Extremely simple yet fast and modern VPN",
        "icon": "/apps/icons/wireguard.png",
        "category": "Network",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "wireguard": {
                    "image": "linuxserver/wireguard:latest",
                    "restart": "unless-stopped",
                    "cap_add": [
                        "NET_ADMIN",
                        "SYS_MODULE"
                    ],
                    "environment": {
                        "PUID": "1000",
                        "PGID": "1000",
                        "TZ": "Europe/Berlin",
                        "PEERS": "1"
                    },
                    "ports": [
                        "51820:51820/udp"
                    ],
                    "volumes": [
                        "${POOL_PATH}/config:/config",
                        "/lib/modules:/lib/modules"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 51820,
                    "external": 51820,
                    "protocol": "udp",
                    "description": "WireGuard port"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration files",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "PEERS",
                    "default": "1",
                    "description": "Number of peers to generate"
                }
            ]
        }
    },
    "openvpn": {
        "name": "OpenVPN",
        "description": "User-friendly VPN solution based on OpenVPN Access Server",
        "icon": "/apps/icons/openvpn.png",
        "category": "Network",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "openvpn": {
                    "image": "lscr.io/linuxserver/openvpn-as:latest",
                    "restart": "unless-stopped",
                    "cap_add": [
                        "NET_ADMIN"
                    ],
                    "environment": {
                        "PUID": "1000",
                        "PGID": "1000",
                        "TZ": "Europe/Berlin"
                    },
                    "ports": [
                        "943:943",
                        "9443:9443",
                        "1194:1194/udp"
                    ],
                    "volumes": [
                        "${POOL_PATH}/config:/config"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 943,
                    "external": 943,
                    "protocol": "tcp",
                    "description": "Admin Web UI"
                },
                {
                    "internal": 1194,
                    "external": 1194,
                    "protocol": "udp",
                    "description": "VPN Port"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration files",
                    "required": true
                }
            ],
            "webui_path": "/admin"
        }
    }
}
