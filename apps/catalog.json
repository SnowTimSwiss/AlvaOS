        "config_schema": {
            "ports": [
                {
                    "internal": 80,
                    "external": 8090,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/data",
                    "description": "Vault data",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "WEBSOCKET_ENABLED",
