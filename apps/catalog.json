    "immich": {
        "name": "Immich",
        "description": "High-performance self-hosted photo and video backup solution",
        "icon": "/apps/icons/immich.png",
        "category": "Media",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "immich-server": {
                    "image": "ghcr.io/immich-app/immich-server:release",
                    "restart": "unless-stopped",
                    "ports": [
                        "2283:3001"
                    ],
                    "volumes": [
                        "${POOL_PATH}/upload:/usr/src/app/upload"
                    ],
                    "environment": {
                        "DB_HOSTNAME": "immich-postgres",
                        "DB_USERNAME": "postgres",
                        "DB_PASSWORD": "postgres",
                        "DB_DATABASE_NAME": "immich",
                        "REDIS_HOSTNAME": "immich-redis",
                        "TZ": "Europe/Berlin"
                    },
                    "depends_on": [
                        "immich-redis",
                        "immich-postgres"
                    ]
                },
                "immich-redis": {
                    "image": "redis:7-alpine",
                    "restart": "unless-stopped"
                },
                "immich-postgres": {
                    "image": "tensorchord/pgvecto-rs:pg14-v0.2.0",
                    "restart": "unless-stopped",
                    "volumes": [
                        "${POOL_PATH}/postgres:/var/lib/postgresql/data"
                    ],
                    "environment": {
                        "POSTGRES_PASSWORD": "postgres",
                        "POSTGRES_USER": "postgres",
                        "POSTGRES_DB": "immich"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 3001,
                    "external": 2283,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/usr/src/app/upload",
                    "description": "Uploaded photos and videos",
                    "required": true
                },
                {
                    "container_path": "/var/lib/postgresql/data",
                    "description": "Database storage",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "DB_PASSWORD",
                    "default": "postgres",
                    "description": "Database password"
                },
                {
                    "key": "TZ",
                    "default": "Europe/Berlin",
                    "description": "Timezone"
                }
            ]
        }
    },
    "owncloud": {
        "name": "ownCloud",
        "description": "Classic self-hosted file sync and share server",
        "icon": "/apps/icons/owncloud.png",
        "category": "Productivity",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "owncloud": {
                    "image": "owncloud/server:latest",
                    "restart": "unless-stopped",
                    "ports": [
                        "8082:8080"
                    ],
                    "volumes": [
                        "${POOL_PATH}/data:/var/www/html"
                    ],
                    "environment": {
                        "OWNCLOUD_DOMAIN": "localhost:8082",
                        "OWNCLOUD_TRUSTED_DOMAINS": "localhost,127.0.0.1",
                        "OWNCLOUD_DB_TYPE": "sqlite",
                        "OWNCLOUD_ADMIN_USERNAME": "admin",
                        "OWNCLOUD_ADMIN_PASSWORD": "admin"
                    }
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 8080,
                    "external": 8082,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/var/www/html",
                    "description": "ownCloud data and config",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "OWNCLOUD_DOMAIN",
                    "default": "localhost:8082",
                    "description": "Public host:port used to access ownCloud"
                },
                {
                    "key": "OWNCLOUD_TRUSTED_DOMAINS",
                    "default": "localhost,127.0.0.1",
                    "description": "Comma-separated trusted domains"
                },
                {
                    "key": "OWNCLOUD_ADMIN_PASSWORD",
                    "default": "admin",
                    "description": "Admin password"
                }
            ]
        }
    },
    "opencloud": {
