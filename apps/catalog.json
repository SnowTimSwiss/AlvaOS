    "transmission": {
        "name": "Transmission",
        "description": "Fast, easy, and free BitTorrent client",
        "icon": "/apps/icons/transmission.png",
        "category": "Media",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "transmission": {
                    "image": "linuxserver/transmission:latest",
                    "restart": "unless-stopped",
                    "environment": {
                        "USER": "admin",
                        "PASS": "admin",
                        "TZ": "Europe/Berlin"
                    },
                    "ports": [
                        "9091:9091",
                        "51413:51413",
                        "51413:51413/udp"
                    ],
                    "volumes": [
                        "${POOL_PATH}/config:/config",
                        "${POOL_PATH}/downloads:/downloads",
                        "${POOL_PATH}/watch:/watch"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 9091,
                    "external": 9091,
                    "protocol": "tcp",
                    "description": "Web UI"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration files",
                    "required": true
                },
                {
                    "container_path": "/downloads",
                    "description": "Downloads directory",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "PASS",
                    "default": "admin",
                    "description": "Web UI password"
                }
            ]
        }
    },
    "wireguard": {
        "name": "WireGuard",
        "description": "Extremely simple yet fast and modern VPN",
        "icon": "/apps/icons/wireguard.png",
        "category": "Network",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "wireguard": {
                    "image": "linuxserver/wireguard:latest",
                    "restart": "unless-stopped",
                    "cap_add": [
                        "NET_ADMIN",
                        "SYS_MODULE"
                    ],
                    "environment": {
                        "PUID": "1000",
                        "PGID": "1000",
                        "TZ": "Europe/Berlin",
                        "PEERS": "1"
                    },
                    "ports": [
                        "51820:51820/udp"
                    ],
                    "volumes": [
                        "${POOL_PATH}/config:/config",
                        "/lib/modules:/lib/modules"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 51820,
                    "external": 51820,
                    "protocol": "udp",
                    "description": "WireGuard port"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration files",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "PEERS",
                    "default": "1",
                    "description": "Number of peers to generate"
                }
            ]
        }
    },
    "openvpn": {
        "name": "OpenVPN",
        "description": "User-friendly VPN solution based on OpenVPN Access Server",
        "icon": "/apps/icons/openvpn.png",
        "category": "Network",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "openvpn": {
                    "image": "lscr.io/linuxserver/openvpn-as:latest",
                    "restart": "unless-stopped",
                    "cap_add": [
                        "NET_ADMIN"
                    ],
                    "environment": {
                        "PUID": "1000",
                        "PGID": "1000",
                        "TZ": "Europe/Berlin"
                    },
                    "ports": [
                        "943:943",
                        "9443:9443",
                        "1194:1194/udp"
                    ],
                    "volumes": [
                        "${POOL_PATH}/config:/config"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [
                {
                    "internal": 943,
                    "external": 943,
                    "protocol": "tcp",
                    "description": "Admin Web UI"
                },
                {
                    "internal": 1194,
                    "external": 1194,
                    "protocol": "udp",
                    "description": "VPN Port"
                }
            ],
            "volumes": [
                {
                    "container_path": "/config",
                    "description": "Configuration files",
                    "required": true
                }
            ],
            "webui_path": "/admin"
        }
    },
    "cloudflared": {
        "name": "Cloudflared",
        "description": "Cloudflare Tunnel connector for secure inbound access",
        "icon": "/apps/icons/cloudflared.png",
        "category": "Network",
        "version": "latest",
        "docker_compose": {
            "version": "3",
            "services": {
                "cloudflared": {
                    "image": "cloudflare/cloudflared:latest",
                    "restart": "unless-stopped",
                    "command": "tunnel --no-autoupdate run",
                    "environment": {
                        "TUNNEL_TOKEN": ""
                    },
                    "volumes": [
                        "${POOL_PATH}/config:/etc/cloudflared"
                    ]
                }
            }
        },
        "config_schema": {
            "ports": [],
            "volumes": [
                {
                    "container_path": "/etc/cloudflared",
                    "description": "Tunnel configuration and credentials",
                    "required": true
                }
            ],
            "environment": [
                {
                    "key": "TUNNEL_TOKEN",
                    "default": "",
                    "description": "Cloudflare tunnel token from Zero Trust dashboard"
                }
            ]
        }
    },
